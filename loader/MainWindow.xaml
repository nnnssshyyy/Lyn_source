<Window x:Class="Lyn.Loader.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:art="clr-namespace:Lyn.Loader.Controls"
 Title="VS 3 · Left 4 Dead 2" Icon="/Lyn.Loader;component/Assets/vs3.ico" Width="816" Height="616" MinWidth="816" MinHeight="616" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#EEEEEE" UseLayoutRounding="True" Loaded="OnLoaded" Closing="OnClosing">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#DDDDDD"/><Setter Property="Foreground" Value="#171717"/><Setter Property="BorderBrush" Value="#D5D5D5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7,2"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="CaretBrush" Value="#171717"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="InputFace" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" SnapsToDevicePixels="True"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputFace" Property="BorderBrush" Value="#FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputFace" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Background" Value="#DDDDDD"/><Setter Property="Foreground" Value="#171717"/><Setter Property="BorderBrush" Value="#D5D5D5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7,2"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="CaretBrush" Value="#171717"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
    <Border x:Name="InputFace" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" SnapsToDevicePixels="True"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputFace" Property="BorderBrush" Value="#FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputFace" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="MinHeight" Value="18"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel x:Name="CheckFace" Orientation="Horizontal" Background="Transparent">
    <Grid Width="18" Height="18"><Border x:Name="CheckBorder" Background="#353636" BorderBrush="#505151" BorderThickness="1" CornerRadius="3"/><Path x:Name="CheckMark" Data="M 4,9 L 7,12 L 14,5" Stroke="#F3F3F3" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Grid>
    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="#424343"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="#EEEEEE"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="CheckFace" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Green" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><EventSetter Event="MouseEnter" Handler="ButtonHovered"/><EventSetter Event="MouseLeave" Handler="ButtonLeft"/><Setter Property="Background" Value="#2C8220"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4A9140"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="8,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#369929"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="FlatLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,4"/><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#AAAAAA"/></Style>
  <Style x:Key="CloseOnly" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Width" Value="28"/><Setter Property="Height" Value="24"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="4"><Path x:Name="Mark" Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="#C0C0C0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#1AFFFFFF"/><Setter TargetName="Mark" Property="Stroke" Value="#FFFFFF"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#40E04A4A"/><Setter TargetName="Mark" Property="Stroke" Value="#FFFFFF"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border Margin="8" Background="#111111" BorderBrush="#393939" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
  <Grid x:Name="WindowSurface"><Grid.Clip><RectangleGeometry Rect="0,0,798,598" RadiusX="6" RadiusY="6"/></Grid.Clip>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="BackdropColumn" Width="{Binding LeftColumnWidth,Mode=OneWay}"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <art:PrismBackdrop x:Name="Backdrop"/>
    <Border HorizontalAlignment="Right" Width="22" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#65000000" Offset="0.45"/><GradientStop Color="#D8000000" Offset="0.88"/><GradientStop Color="#FF0A0B0D" Offset="1"/></LinearGradientBrush></Border.Background></Border>
    <Border HorizontalAlignment="Right" Width="1" Background="#191C1F" IsHitTestVisible="False"/>
    <Button x:Name="GameCard" MouseEnter="ButtonHovered" MouseLeave="ButtonLeft" Margin="16,17,20,0" Height="47" VerticalAlignment="Top" AutomationProperties.Name="Seleccionar Left 4 Dead 2" ToolTip="Left 4 Dead 2 · VS 3" Visibility="{Binding IsSignedIn,Converter={StaticResource VisibleWhenTrue}}">
     <Button.Template><ControlTemplate TargetType="Button">
      <Grid>
       <Border x:Name="CardSurface" Margin="0,3,0,3" Background="#424546" CornerRadius="3" BorderBrush="Transparent" BorderThickness="1"/>
       <Image Source="Assets/l4d2-banner.png" Width="94" Height="47" HorizontalAlignment="Left" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,94,47" RadiusX="2" RadiusY="2"/></Image.Clip></Image>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="107,0,0,0"><TextBlock Text="L4D2" FontSize="12" FontWeight="SemiBold" Foreground="#EEEEEE"/><TextBlock Text="VS 3" FontSize="11" Foreground="#A0A4A4" Margin="5,1,0,0"/></StackPanel>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardSurface" Property="Background" Value="#4B5353"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="#91B7AA"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CardSurface" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers>
     </ControlTemplate></Button.Template>
    </Button>
    <Button Content="Gestionar equipo ↗" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,25" Style="{StaticResource FlatLink}" Visibility="{Binding IsSignedIn,Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{Binding CanAuthenticate}" Click="ManageHardwareClicked"/>
    <Grid Grid.Column="1" Background="#111111">
     <Grid x:Name="HomeView">
      <Grid x:Name="LoginView" Visibility="{Binding IsSignedOut,Converter={StaticResource VisibleWhenTrue}}">
       <TextBlock Text="NEVER LOSE" FontSize="50" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"/>
       <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,197,0,0">
        <TextBlock Text="Usuario" FontSize="11" Margin="0,0,0,10"/><TextBox x:Name="UsernameInput" Height="24" IsEnabled="{Binding CanAuthenticate}" AutomationProperties.Name="Usuario"/>
        <TextBlock Text="Contraseña" FontSize="11" Margin="0,33,0,10"/><PasswordBox x:Name="PasswordInput" Height="24" IsEnabled="{Binding CanAuthenticate}" AutomationProperties.Name="Contraseña"/>
        <CheckBox x:Name="RememberUsername" Content="Recordar credenciales" Margin="0,31,0,42" Unchecked="ForgetCredentials"/>
        <Button Content="{Binding LoginLabel}" Style="{StaticResource Green}" Height="40" Click="LoginClicked" IsEnabled="{Binding CanAuthenticate}"/>
        <TextBlock Text="{Binding StatusText}" Visibility="{Binding LoginStatusVisibility}" TextWrapping="Wrap" FontSize="10" Foreground="#C9D7CE" Margin="0,12,0,0"/>
        <StackPanel Visibility="{Binding PendingHardwareVisibility}" Margin="0,10,0,0"><TextBlock Text="{Binding HardwareRequestText}" FontSize="11" FontWeight="Bold"/><Button Content="Autorizar desde la web ↗" Style="{StaticResource FlatLink}" HorizontalAlignment="Left" Click="OpenAccountHardware" Margin="-7,5,0,0"/></StackPanel>
       </StackPanel>
      </Grid>
      <Grid x:Name="SessionView" Visibility="{Binding IsSignedIn,Converter={StaticResource VisibleWhenTrue}}">
       <TextBlock Text="{Binding WelcomeText}" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="13" Margin="0,16,0,0"/>
       <StackPanel Margin="30,62,30,0">
        <Image Source="Assets/l4d2-banner.png" Stretch="Uniform" Height="172"/>
        <StackPanel Margin="0,42,0,0">
         <TextBlock FontSize="11" Margin="0,0,0,12"><Run Text="Juego: "/><Run Text="Left 4 Dead 2" FontWeight="SemiBold"/></TextBlock>
         <TextBlock FontSize="11" Margin="0,0,0,12"><Run Text="Suscripción: "/><Run Text="{Binding SubscriptionText,Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
         <TextBlock FontSize="11" Margin="0,0,0,12"><Run Text="Estado: "/><Run Text="{Binding LicenseStatus,Mode=OneWay}" Foreground="#4FBD34" FontWeight="SemiBold"/></TextBlock>
         <TextBlock FontSize="11"><Run Text="Framework: "/><Run Text="VS 3" FontWeight="SemiBold"/></TextBlock>
         <TextBlock FontSize="11" Foreground="#F0B429" Visibility="{Binding DevVisibility,Mode=OneWay}" Margin="0,12,0,0"><Run Text="MODO DEV: "/><Run Text="DLL local" FontWeight="SemiBold"/></TextBlock>
        </StackPanel>
        <StackPanel Visibility="{Binding NeedsActivation,Converter={StaticResource VisibleWhenTrue}}" Margin="0,25,0,0"><TextBox x:Name="ActivationInput" AutomationProperties.Name="Clave de activación" ToolTip="Clave VS3-…" Height="26"/><Button Content="Activar clave" Style="{StaticResource Green}" Click="ActivateClicked" IsEnabled="{Binding CanAuthenticate}" Height="36" Margin="0,9,0,0"/></StackPanel>
        <StackPanel Visibility="{Binding HasLicense,Converter={StaticResource VisibleWhenTrue}}" Margin="0,43,0,0">
         <CheckBox Content="Recordar selección" IsChecked="True" IsEnabled="False" Margin="0,0,0,16"/>
         <Button Content="{Binding LoadLabel}" Style="{StaticResource Green}" Click="LoadClicked" IsEnabled="{Binding CanLoadOrLaunch}" Height="40"/>
         <Grid x:Name="BusySpinner" Width="18" Height="18" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,10,0,0"><Ellipse Stroke="#59A147" StrokeThickness="2" StrokeDashArray="6 20" StrokeDashCap="Round" Width="18" Height="18"><Ellipse.RenderTransform><RotateTransform x:Name="SpinnerRotation" CenterX="9" CenterY="9"/></Ellipse.RenderTransform></Ellipse></Grid>
        </StackPanel>
       </StackPanel>
      </Grid>
     </Grid>
    </Grid>
    <Grid Grid.Column="1" Height="28" VerticalAlignment="Top" MouseLeftButtonDown="DragTitle" Background="Transparent"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,2,0">
      <Button Style="{StaticResource CloseOnly}" Click="CloseWindow" ToolTip="Cerrar" AutomationProperties.Name="Cerrar"/>
    </StackPanel></Grid>
   </Grid>
  </Grid>
 </Border>
</Window>


